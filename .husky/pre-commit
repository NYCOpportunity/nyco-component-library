# Quality gate — runs the full check suite before every commit.
# Commit is aborted if any step fails.
#   1. lint:ci      — ESLint, no errors, no unused code (--max-warnings=0)
#   2. type-check   — TypeScript across the whole project
#   3. format:check — Prettier formatting verification
echo "▶ Running full quality checks before commit…"
pnpm run check || {
  echo "✖ Checks failed — commit aborted. Fix the issues above and try again."
  exit 1
}
echo "✔ All checks passed."
