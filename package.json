{
  "name": "@nycopportunity/component-library",
  "version": "0.1.0",
  "description": "A React component library for NYC Opportunity projects, built with TypeScript, Tailwind CSS, and Storybook",
  "keywords": [
    "react",
    "components",
    "ui",
    "nyc",
    "opportunity",
    "typescript",
    "tailwind"
  ],
  "author": "NYC Opportunity",
  "license": "MIT",
  "homepage": "https://github.com/NYCOpportunity/nyco-component-library#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/NYCOpportunity/nyco-component-library.git"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "dist/style.css"
  ],
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/doitt-compute-services/nyco-products/_packaging/nycopportunity/npm/registry/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json",
    "build:vite": "vite build",
    "build": "pnpm run build:vite && pnpm run build:ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "pack": "npm pack",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:ci": "eslint 'src/**/*.{ts,tsx}' --max-warnings=0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,json}'",
    "check": "pnpm run lint:ci && pnpm run type-check && pnpm run format:check",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "src/**/*.{css,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-essentials": "^7.6.24",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.15",
    "@types/node": "^25.9.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "0.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  },
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8"
}
